# Copiá este archivo a .env y completá los valores para desarrollo local.
# En Railway, estas mismas claves se definen como variables de entorno
# del servicio (Settings → Variables), no como archivo.

SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Opcional — si no se define, se usa SQLite local en instance/levelup.db
# DATABASE_URL=sqlite:///instance/levelup.db
